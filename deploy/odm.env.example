# Example ODM secrets/config file. Install as /etc/odm/odm.env with mode 0640
# (root:odm) — the API refuses to read a group-writable or world-accessible file.
#
# Real credentials NEVER go in the repository (CLAUDE.md §6).

# --- Domain ---
ODM_REALM=CORP.EXAMPLE.INTERNAL
ODM_DOMAIN=corp.example.internal
# Group whose members may sign in to the web UI.
ODM_ADMIN_GROUP=Domain Admins

# Derived from ODM_DOMAIN unless set explicitly.
#ODM_BASE_DN=DC=corp,DC=example,DC=internal

# --- LDAP (LDAPS only) ---
ODM_LDAP_URI=ldaps://dc1.corp.example.internal
ODM_LDAP_CA_CERT=/etc/odm/tls/dc-ca.pem
#ODM_LDAP_TIMEOUT_SECONDS=10

# --- Kerberos ---
# Keytab produced by deploy/create-api-service-account.sh (mode 0600).
ODM_KEYTAB=/etc/odm/odm-api.keytab
# The service class of the SPN the keytab holds.
#ODM_SERVICE_NAME=HTTP

# --- Database (written by deploy/setup-db.sh) ---
ODM_DATABASE_URL=postgresql://odm:CHANGE_ME@127.0.0.1/odm
#ODM_DB_POOL_MIN=1
#ODM_DB_POOL_MAX=10

# --- Web ---
# Where the built console lives. Set, the control plane serves it, so the
# console and the API share an origin without a proxy in front.
ODM_CONSOLE_DIR=/opt/odm/console

# Exact origin the console is served from; anything else is refused on writes.
ODM_ALLOWED_ORIGINS=["https://odm.corp.example.internal"]

# --- Sessions ---
ODM_SESSION_TTL_MINUTES=480
ODM_SESSION_IDLE_MINUTES=60
ODM_LOGIN_MAX_FAILURES=5
ODM_LOGIN_LOCKOUT_MINUTES=15
# How often a live session's group membership is re-proven against the
# directory. Lower means revocation takes effect sooner.
ODM_ADMIN_RECHECK_MINUTES=5
#ODM_SESSION_COOKIE_NAME=odm_session
# Only ever set this false behind a TLS-terminating proxy on the same host.
#ODM_COOKIE_SECURE=true

# --- Group Policy ---
# Set ONLY when the API runs on a domain controller: enables mirroring policy
# objects into LDAP and SYSVOL so GPMC/RSAT see the same structure. Left
# unset, group policy objects are ODM-only and live in PostgreSQL.
#ODM_SYSVOL_PATH=/var/lib/samba/sysvol/corp.example.internal/Policies
# Fallback agent check-in interval when no policy sets one.
ODM_AGENT_REFRESH_MINUTES=15

# --- DHCP role (written by deploy/install-dhcp-role.sh) ---
# Left unset until the role is installed; the DHCP UI then says so instead
# of failing obscurely. Plaintext is accepted only on the loopback.
#ODM_KEA_URL=http://127.0.0.1:8000/
#ODM_KEA_USER=odm
#ODM_KEA_PASSWORD=CHANGE_ME
#ODM_KEA_CA_CERT=/etc/odm/tls/kea-ca.pem

# --- Certificate authority (written by the certificate-authority role) ---
#ODM_CA_DIR=/var/lib/odm/ca

# --- Backups ---
# Unset, backups are unavailable and the console says so. samba-tool must be
# present, so this only works where the API runs on a domain controller.
#ODM_BACKUP_DIR=/var/backups/odm
ODM_BACKUP_INTERVAL_HOURS=24
ODM_BACKUP_KEEP=14

# --- Recycle bin retention (days) ---
ODM_RETENTION_DAYS=180
