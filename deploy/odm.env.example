# Example ODM secrets/config file. Install as /etc/odm/odm.env with mode 0640
# (root:odm) — the API refuses to read a group-writable or world-accessible file.
#
# Real credentials NEVER go in the repository (CLAUDE.md §6).

# --- Domain ---
ODM_REALM=CORP.EXAMPLE.INTERNAL
ODM_DOMAIN=corp.example.internal
# Group whose members may sign in to the web UI.
ODM_ADMIN_GROUP=Domain Admins

# --- LDAP (LDAPS only) ---
ODM_LDAP_URI=ldaps://dc1.corp.example.internal
ODM_LDAP_CA_CERT=/etc/odm/tls/dc-ca.pem

# --- Kerberos ---
# Keytab produced by deploy/create-api-service-account.sh (mode 0600).
ODM_KEYTAB=/etc/odm/odm-api.keytab

# --- Database (written by deploy/setup-db.sh) ---
ODM_DATABASE_URL=postgresql://odm:CHANGE_ME@127.0.0.1/odm

# --- Web ---
# Exact origin the UI is served from; anything else is refused on writes.
ODM_ALLOWED_ORIGINS=["https://odm.corp.example.internal"]

# --- Sessions ---
ODM_SESSION_TTL_MINUTES=480
ODM_SESSION_IDLE_MINUTES=60
ODM_LOGIN_MAX_FAILURES=5
ODM_LOGIN_LOCKOUT_MINUTES=15

# --- Group Policy ---
# Set ONLY when the API runs on a domain controller: enables mirroring policy
# objects into LDAP and SYSVOL so GPMC/RSAT see the same structure. Left
# unset, group policy objects are ODM-only and live in PostgreSQL.
#ODM_SYSVOL_PATH=/var/lib/samba/sysvol/corp.example.internal/Policies
# Fallback agent check-in interval when no policy sets one.
ODM_AGENT_REFRESH_MINUTES=15

# --- Recycle bin retention (days) ---
ODM_RETENTION_DAYS=180
