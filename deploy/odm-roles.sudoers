# Install as /etc/sudoers.d/odm-roles, mode 0440 root:root.
#
# The ODM API runs as the unprivileged odm user and needs root for exactly
# two things: installing a server role, and installing a new certificate for
# the administration console. This grants those two commands and nothing
# else — not a shell, not apt, not the installers directly.
odm ALL=(root) NOPASSWD: /opt/odm/bin/odm-role-install
odm ALL=(root) NOPASSWD: /opt/odm/bin/odm-apply-console-certificate
Defaults!/opt/odm/bin/odm-role-install !requiretty
Defaults!/opt/odm/bin/odm-apply-console-certificate !requiretty
