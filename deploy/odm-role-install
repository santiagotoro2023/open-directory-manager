#!/usr/bin/env bash
# Privileged helper for the ODM role framework.
#
# The API runs unprivileged and cannot install packages. It invokes this one
# command through sudo — see odm-roles.sudoers, which names exactly this path
# and nothing else — and this script maps a role name to its installer. The
# role name is matched against a fixed case here as well as validated in the
# API, so a bad name can never become a path.

set -euo pipefail

ROLES_DIR="${ODM_ROLES_DIR:-/opt/odm/deploy}"
ROLE="${1:-}"
shift || true

[[ $EUID -eq 0 ]] || { echo "odm-role-install must run as root" >&2; exit 1; }

case "$ROLE" in
    dhcp)                  INSTALLER="$ROLES_DIR/install-dhcp-role.sh" ;;
    file-server)           INSTALLER="$ROLES_DIR/install-file-server-role.sh" ;;
    certificate-authority) INSTALLER="$ROLES_DIR/install-certificate-authority-role.sh" ;;
    pxe)                   INSTALLER="$ROLES_DIR/install-pxe-role.sh" ;;
    print-server)          INSTALLER="$ROLES_DIR/install-print-server-role.sh" ;;
    vpn)                   INSTALLER="$ROLES_DIR/install-vpn-role.sh" ;;
    radius)                INSTALLER="$ROLES_DIR/install-radius-role.sh" ;;
    *)           echo "unknown role: $ROLE" >&2; exit 2 ;;
esac

[[ -x "$INSTALLER" ]] || { echo "installer not found: $INSTALLER" >&2; exit 1; }
exec "$INSTALLER" "$@"
