# Settings for docker-compose.yml. Copy to .env beside it (never commit it).

# The domain: its Kerberos realm in capitals, and the same name in DNS.
ODM_REALM=CORP.EXAMPLE.INTERNAL
ODM_DOMAIN=corp.example.internal
# Optional: the NetBIOS domain name (default: the first label, in capitals).
#ODM_NETBIOS=CORP

# This host's own address on the network the domain serves. The controller
# answers DNS, Kerberos and LDAP on it, and the console is published on it.
ODM_HOST_ADDRESS=192.0.2.10

# The controller's name, and the console's: dc1.<domain>, odm.<domain>.
ODM_DC_NAME=dc1
ODM_CONSOLE_NAME=odm

# The domain Administrator's password, set when the domain is provisioned.
# At least 8 characters, with upper case, lower case and a digit or symbol.
ODM_ADMIN_PASSWORD=
# PostgreSQL's password for the control plane.
POSTGRES_PASSWORD=

# Where the domain's DNS sends what it does not answer itself.
#ODM_DNS_FORWARDER=9.9.9.9

# Which image version to run (default: latest).
#ODM_VERSION=0.17.6
