# Settings for deploy/compose/node/docker-compose.yml. Copy to .env beside it.

# This machine's short name (it becomes <name>.<domain>) and its address.
ODM_NODE_NAME=srv1
ODM_NODE_ADDRESS=192.0.2.21

# member: a server to install roles on. domain-controller: another controller.
ODM_NODE_ROLE=member

ODM_REALM=CORP.EXAMPLE.INTERNAL
# The existing controllers' addresses, comma separated.
ODM_DNS_SERVERS=192.0.2.10

# For another controller: the controller to join from.
#ODM_DC_JOIN=dc1

# A member joins with a token from the console (Directory → Join tokens),
# checking the console against its certificate (on the first host:
# docker compose cp odm:/srv/odm-data/tls/api.crt console.pem) ...
#ODM_JOIN_TOKEN=
#ODM_CONSOLE_CA_CERT_FILE=./console.pem
# ... or with the domain Administrator's password, which another controller
# always needs.
#ODM_ADMIN_PASSWORD=

#ODM_VERSION=0.17.6
