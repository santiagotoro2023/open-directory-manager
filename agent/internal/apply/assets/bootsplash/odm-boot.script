# Managed by Open Directory Manager.
#
# Plymouth's own scripting language (CLAUDE.md §6 — Plymouth is the audited
# mechanism reused here, this script only orchestrates it): every function
# used below — Window.SetBackgroundTopColor, Image, Sprite, SetImage,
# SetX/SetY/SetZ, Plymouth.SetRefreshFunction and Plymouth.SetMessageFunction
# — is long-standing, documented Plymouth Script API, checked here against
# Debian's own shipped theme (ceratopsian.script, in the plymouth-themes
# package) rather than assumed. Nothing here reaches outside Plymouth's own
# sandboxed drawing API: no file access, no shell, no network.
#
# background.png and watermark.png are optional — Image() returns a null
# value Plymouth Script treats as false when a file does not exist, which is
# how this tells "no logo chosen" from "logo chosen" without a file of its
# own to check first.
#
# A variable set at the top level of this file is only visible by that name
# at the top level; a function that reads or writes one has to say
# global.name, or it creates a same-named local of its own instead and the
# outer one never changes. Every reference to throbber_current_frame,
# throbber_tick, throbber_sprite, throbber_frames and message_sprite below a
# fun block is written the "global." way for exactly that reason.

Window.SetBackgroundTopColor(0.09, 0.09, 0.11);
Window.SetBackgroundBottomColor(0.09, 0.09, 0.11);

background_image = Image("background.png");
if (background_image) {
    # Scaled to cover the whole window while preserving the picture's own
    # aspect ratio, rather than stretched to exactly match the window's
    # dimensions the way this used to. A stretch is exactly what showed up
    # as a picture visibly pulled out of shape whenever its own aspect
    # ratio did not match the boot screen's actual resolution — which is
    # routine, since an operator uploads whatever photo they have, not one
    # cropped to this specific machine's own early-boot graphics mode.
    # Covering means scaling by whichever of the two ratios is larger, so
    # the window is always completely filled, then centering — anything
    # beyond the window's own edges is simply off-screen, the same as a
    # CSS "background-size: cover" would crop it.
    width_scale = Window.GetWidth() / background_image.GetWidth();
    height_scale = Window.GetHeight() / background_image.GetHeight();
    cover_scale = width_scale;
    if (height_scale > width_scale) {
        cover_scale = height_scale;
    }
    scaled_width = background_image.GetWidth() * cover_scale;
    scaled_height = background_image.GetHeight() * cover_scale;
    background_image = background_image.Scale(scaled_width, scaled_height);
    background_sprite = Sprite(background_image);
    background_sprite.SetX(Window.GetX() + (Window.GetWidth() - scaled_width) / 2);
    background_sprite.SetY(Window.GetY() + (Window.GetHeight() - scaled_height) / 2);
    background_sprite.SetZ(-100);
}

# Where the spinner's top edge goes: centred on the screen unless a logo
# takes the centre, in which case the logo block below moves it down to sit
# beneath the logo. 48 is half the spinner frames' 96px height.
throbber_y = Window.GetY() + Window.GetHeight() / 2 - 48;

logo_image = Image("watermark.png");
if (logo_image) {
    # An operator-uploaded logo arrives at whatever resolution it was
    # uploaded at, which is routinely far larger than a boot framebuffer —
    # unlike background.png above, nothing here previously capped its size,
    # so it was drawn edge-to-edge instead of as a small watermark. Scaled
    # down (never up, so a small logo is not blown up either) to a fraction
    # of the window's own width, the same relative size a Plymouth watermark
    # is meant to read as.
    logo_max_width = Window.GetWidth() * 0.18;
    if (logo_image.GetWidth() > logo_max_width) {
        logo_scale = logo_max_width / logo_image.GetWidth();
        logo_image = logo_image.Scale(logo_image.GetWidth() * logo_scale, logo_image.GetHeight() * logo_scale);
    }
    # The logo is the centre of the screen and the spinner hangs beneath it.
    # A brand mark dead centre with a loading indicator under it is the
    # order a splash screen with both reads as; an earlier version gave the
    # spinner the exact centre and pushed the logo up above it, which read
    # as the spinner being the point.
    logo_sprite = Sprite(logo_image);
    logo_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
    logo_sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo_image.GetHeight() / 2);
    logo_sprite.SetZ(10);
    throbber_y = Window.GetY() + Window.GetHeight() / 2 + logo_image.GetHeight() / 2 + Window.GetHeight() * 0.05;
}

# A pre-rendered rotating-arc spinner (a fading ring, not discrete dots) —
# generated once and shipped with the agent rather than depending on another
# theme's own frame files being present under some particular name. That is
# the one part of this drawn without a live display to check it against, so
# it is images to composite, not script logic to get right blind.
#
# 36 frames (10 degrees apart) rather than the original 12 (30 degrees
# apart): a hand-off between two out of only twelve positions around the
# ring reads as a series of jumps rather than a turn, especially on the
# large, near-full-screen render size this theme uses. Three times the
# angular resolution is what makes it read as continuous motion.
throbber_frames[0] = Image("throbber-00.png");
throbber_frames[1] = Image("throbber-01.png");
throbber_frames[2] = Image("throbber-02.png");
throbber_frames[3] = Image("throbber-03.png");
throbber_frames[4] = Image("throbber-04.png");
throbber_frames[5] = Image("throbber-05.png");
throbber_frames[6] = Image("throbber-06.png");
throbber_frames[7] = Image("throbber-07.png");
throbber_frames[8] = Image("throbber-08.png");
throbber_frames[9] = Image("throbber-09.png");
throbber_frames[10] = Image("throbber-10.png");
throbber_frames[11] = Image("throbber-11.png");
throbber_frames[12] = Image("throbber-12.png");
throbber_frames[13] = Image("throbber-13.png");
throbber_frames[14] = Image("throbber-14.png");
throbber_frames[15] = Image("throbber-15.png");
throbber_frames[16] = Image("throbber-16.png");
throbber_frames[17] = Image("throbber-17.png");
throbber_frames[18] = Image("throbber-18.png");
throbber_frames[19] = Image("throbber-19.png");
throbber_frames[20] = Image("throbber-20.png");
throbber_frames[21] = Image("throbber-21.png");
throbber_frames[22] = Image("throbber-22.png");
throbber_frames[23] = Image("throbber-23.png");
throbber_frames[24] = Image("throbber-24.png");
throbber_frames[25] = Image("throbber-25.png");
throbber_frames[26] = Image("throbber-26.png");
throbber_frames[27] = Image("throbber-27.png");
throbber_frames[28] = Image("throbber-28.png");
throbber_frames[29] = Image("throbber-29.png");
throbber_frames[30] = Image("throbber-30.png");
throbber_frames[31] = Image("throbber-31.png");
throbber_frames[32] = Image("throbber-32.png");
throbber_frames[33] = Image("throbber-33.png");
throbber_frames[34] = Image("throbber-34.png");
throbber_frames[35] = Image("throbber-35.png");
throbber_frame_count = 36;
throbber_current_frame = 0;
throbber_tick = 0;

throbber_sprite = Sprite(throbber_frames[0]);
throbber_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - throbber_frames[0].GetWidth() / 2);
throbber_sprite.SetY(throbber_y);
throbber_sprite.SetZ(20);

# Plymouth calls this up to fifty times a second (the same rate Debian's own
# ceratopsian.script documents). Advancing one frame every second tick with
# 36 frames is a full turn in a little under a second and a half — brisk
# enough to read as active, slow enough that individual frames do not blur
# together into flicker.
fun refresh_callback() {
    global.throbber_tick++;
    if (global.throbber_tick < 2) {
        return;
    }
    global.throbber_tick = 0;
    global.throbber_current_frame++;
    if (global.throbber_current_frame >= global.throbber_frame_count) {
        global.throbber_current_frame = 0;
    }
    global.throbber_sprite.SetImage(global.throbber_frames[global.throbber_current_frame]);
}

Plymouth.SetRefreshFunction(refresh_callback);

# The message a policy sets arrives through Plymouth's own display-message
# command, the same one every other boot-time message on this system already
# uses (fsck, cryptsetup) — SetMessageFunction is what actually receives it;
# without a theme that registers one the command has nothing to draw with.
message_sprite = 0;

fun message_callback(text) {
    message_image = Image.Text(text, 1, 1, 1);
    if (global.message_sprite == 0) {
        global.message_sprite = Sprite(message_image);
        global.message_sprite.SetZ(20);
    } else {
        global.message_sprite.SetImage(message_image);
    }
    global.message_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - message_image.GetWidth() / 2);
    global.message_sprite.SetY(Window.GetY() + Window.GetHeight() * 0.78);
}

Plymouth.SetMessageFunction(message_callback);
